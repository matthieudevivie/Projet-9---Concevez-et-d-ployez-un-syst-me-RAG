# Fichier .env.example (commité)
# Copier ce fichier en .env (jamais commité) et y mettre ta clé.
# Clé à créer sur https://openrouter.ai/settings/keys (une clé par projet, avec une limite de crédit)
OPENROUTER_API_KEY=

# Modèles Mistral servis par OpenRouter : identifiants datés, pour la reproductibilité.
# Changer EMBEDDING_MODEL impose de reconstruire l'index.
LLM_MODEL=mistralai/mistral-small-2603
EMBEDDING_MODEL=mistralai/mistral-embed-2312